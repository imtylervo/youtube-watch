# Copy to ~/.config/yt-watch.env  (chmod 600) and fill in real values.
# Auto-loaded by extract-v3.sh. The proxy is used ONLY when a
# direct request to YouTube is blocked — it is not applied to other traffic.
#
# --- Example: NordVPN HTTPS proxy (flat rate, suits video downloads) ---
# - Port is 89.
# - Username/password = NordVPN *service credentials* (dashboard → "Set up
#   NordVPN manually" → Service credentials), NOT your account login.
# - Address the server as <server>.proxy.nordvpn.com so the proxy's TLS cert
#   (*.proxy.nordvpn.com) matches — using <server>.nordvpn.com fails cert verify.
# - Pick/refresh a proxy-capable server:
#     curl -s "https://api.nordvpn.com/v1/servers/recommendations?filters%5Bservers_technologies%5D%5Bidentifier%5D=proxy_ssl&filters%5Bcountry_id%5D=228&limit=5" \
#       | python3 -c "import sys,json;[print(s['hostname'],'load',s['load']) for s in json.load(sys.stdin)]"
#   (country_id 228 = US)
export YT_PROXY="https://SERVICE_USER:SERVICE_PASS@us8502.proxy.nordvpn.com:89"

# --- Alternative: residential HTTP proxy (metered) ---
# export YT_PROXY="http://USER:PASS@host:PORT"
